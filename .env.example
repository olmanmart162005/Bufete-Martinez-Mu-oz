# Configuración del Sitio
SITE_NAME="Bufete Jurídico Martínez Muñoz"
SITE_URL="https://bufetemartinezmunoz.com"
PORT=8080

# Canales Oficiales
CONTACT_PHONE="+50432948396"
CONTACT_WHATSAPP="+50432948396"
CONTACT_EMAIL="contacto@bufetemartinezmunoz.com"
OFFICE_LOCATION="Honduras"
MAPS_URL="https://share.google/VONZJvOMzdsaSsqNu"

# Base de Datos (PostgreSQL / Supabase)
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/bjmm_db"
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-publica"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-privada-nunca-en-frontend"

# Notificaciones y Despacho de Correo (SMTP / Resend)
SMTP_HOST="smtp.proveedor.com"
SMTP_PORT=587
SMTP_USER="notificaciones@bufetemartinezmunoz.com"
SMTP_PASS="clave-aplicacion-segura"
